# Point this at your local MySQL (managed via phpMyAdmin) in development,
# and at the VPS MySQL instance in production. Format:
# mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://root:@localhost:3306/cececo"

# Signs/encrypts the admin session cookie — must be at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Used once by `npm run db:seed-admin` to create the first admin login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
